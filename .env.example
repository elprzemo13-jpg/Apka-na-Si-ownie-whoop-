# Copy to .env.local and fill in from the Supabase dashboard:
#   URL: Project Settings -> Data API -> Project URL
#   KEY: Project Settings -> API Keys -> "Publishable key" (sb_publishable_...)
#        or, on older projects, the legacy "anon public" key.
# Both are safe in the browser; data is protected by RLS.
# NEVER put the secret / service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
